# Copy to .env for local development. Never commit real values.
NODE_ENV=development
DATABASE_URL=postgres://dakly_app:dakly_app@localhost:5432/dakly
DATABASE_ADMIN_URL=postgres://dakly:dakly@localhost:5432/dakly
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_HOST=0.0.0.0
# Local Next proxy only. Production must list its exact trusted proxy IPs or CIDRs.
API_TRUSTED_PROXIES=127.0.0.1,::1
# Comma-separated browser origins; web and API share an origin through the /api proxy.
WEB_ORIGINS=http://localhost:3000
# Optional error reporting; leave unset to disable outbound events.
# SENTRY_DSN=
# Development capture only; never select mailpit in production.
SMS_DRIVER=mailpit
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
# Read-back endpoint for integration tests.
MAILPIT_API_URL=http://127.0.0.1:8025

# Transactional email: SMTP for development; production requires SendGrid.
EMAIL_DRIVER=smtp
# EMAIL_FROM=
# SENDGRID_API_KEY=

# Development only. Production requires google and an OAuth client audience.
GOOGLE_IDENTITY_DRIVER=fake
# GOOGLE_CLIENT_ID=

# Required when a feature imports CryptoModule; no default key is provided.
# Master keys: JSON object mapping positive versions to canonical base64 32-byte keys.
# Keep previous versions for decryption when selecting a new current version.
# ENCRYPTION_CURRENT_KEY_VERSION=
# ENCRYPTION_MASTER_KEYS=

# Staff app uses a separate origin and requires signed Cloudflare Access assertions.
ADMIN_ORIGIN=http://localhost:3010
# ADMIN_API_URL=
# CLOUDFLARE_ACCESS_ISSUER=
# CLOUDFLARE_ACCESS_AUDIENCE=
# CLOUDFLARE_ACCESS_DEVELOPMENT_JWKS=
# STAFF_SESSION_SIGNING_KEY=

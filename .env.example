# Copy to .env for local development. Never commit real values.
NODE_ENV=development
DATABASE_URL=postgres://dakly_app:dakly_app@localhost:5432/dakly
DATABASE_ADMIN_URL=postgres://dakly:dakly@localhost:5432/dakly
REDIS_URL=redis://localhost:6379
# Test runs set their own BullMQ prefix; leave unset elsewhere.
# QUEUE_PREFIX=bull
API_PORT=4000
API_HOST=0.0.0.0
# Local Next proxy only. Production must list its exact trusted proxy IPs or CIDRs.
API_TRUSTED_PROXIES=127.0.0.1,::1
# Comma-separated browser origins; web and API share an origin through the /api proxy.
WEB_ORIGINS=http://localhost:3000
# Tracked links and the SMS opt-out page, with no trailing slash. Production uses the short domain.
SHORT_LINK_BASE_URL=http://localhost:4000/l
# Set both to enable incoming Meta webhooks.
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# Enable account authorization locally with the fake driver.
# META_CHANNEL_DRIVER=fake
# META_OAUTH_REDIRECT_URI=http://localhost:3000/integrations/meta
# Graph needs the app secret and an HTTPS redirect.
# Use a User access token login configuration with pages_show_list, pages_manage_metadata,
# instagram_basic and pages_read_engagement. Add business_management for business-linked Pages.
# Use pages_messaging for Messenger webhook subscriptions.
# META_APP_ID=
# META_LOGIN_CONFIG_ID=

# Development model responses come from the scripted driver.
LLM_DRIVER=fake
# OPENAI_API_KEY=
# AI_REPLY_MODEL=gpt-6-luna
# AI_FAST_MODEL=gpt-6-luna
# AI_VISION_MODEL=gpt-6-luna
# AI_HANDWRITING_MODEL reads handwritten Khata pages; the cheaper vision model made up names on real handwriting.
# AI_HANDWRITING_MODEL=gpt-6.1-terra
# AI_WRITER_MODEL=gpt-6.1-terra
# AI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# AI_EMBEDDING_MODEL=text-embedding-3-large
# AI_MODEL_PRICES is JSON keyed by model, with input, cachedInput and output prices in micro-USD per million tokens.
# AI_EVAL_STORE_ID is the shop the nightly golden-set eval asks; leave unset to skip the eval.
# Optional error reporting; leave unset to disable outbound events.
# SENTRY_DSN=
# Development capture only; never select mailpit in production.
SMS_DRIVER=mailpit
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
# Read-back endpoint for integration tests.
MAILPIT_API_URL=http://127.0.0.1:8025

# Transactional email: SMTP for development; production requires SendGrid.
EMAIL_DRIVER=smtp
# EMAIL_FROM=
# SENDGRID_API_KEY=

# bKash merchant account for Dakly's own billing. Optional; shop accounts use stored credentials.
# BKASH_BILLING_MODE=sandbox
# BKASH_BILLING_APP_KEY=
# BKASH_BILLING_APP_SECRET=
# BKASH_BILLING_USERNAME=
# BKASH_BILLING_PASSWORD=

# File storage: Cloudflare R2 in production, SeaweedFS from docker compose locally. Local values only.
R2_ENDPOINT=http://127.0.0.1:8333
R2_BUCKET=dakly-local
R2_ACCESS_KEY_ID=dakly-local
R2_SECRET_ACCESS_KEY=dakly-local-secret

# Development only. Production requires google and an OAuth client audience.
GOOGLE_IDENTITY_DRIVER=fake
# GOOGLE_CLIENT_ID=

# Required when a feature imports CryptoModule; no default key is provided.
# Master keys: JSON object mapping positive versions to canonical base64 32-byte keys.
# Keep previous versions for decryption when selecting a new current version.
# ENCRYPTION_CURRENT_KEY_VERSION=
# ENCRYPTION_MASTER_KEYS=

# Keys the hashes of sign-in codes and backup codes. Base64, at least 32 random bytes.
# Changing it ends codes already sent and makes stored backup codes stop working.
# CODE_HASH_KEY=

# Staff app uses a separate origin and requires signed Cloudflare Access assertions.
ADMIN_ORIGIN=http://localhost:3010
# ADMIN_API_URL=
# CLOUDFLARE_ACCESS_ISSUER=
# CLOUDFLARE_ACCESS_AUDIENCE=
# CLOUDFLARE_ACCESS_DEVELOPMENT_JWKS=
# STAFF_SESSION_SIGNING_KEY=

# Published HTTPS documents and accepted version. Missing values disable registration.
WEB_TERMS_URL=
WEB_PRIVACY_URL=
WEB_TERMS_VERSION=
# Must match the API GOOGLE_CLIENT_ID and the authorized browser origins.
WEB_GOOGLE_CLIENT_ID=
# Local tunnel hosts such as *.ngrok-free.app that may load the dev server. Add the tunnel origin to WEB_ORIGINS too.
# WEB_ALLOWED_DEV_ORIGINS=

# Cloudflare Turnstile for the public order link. Unset: a fake check outside production, link closed in production.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

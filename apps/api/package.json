    "nestjs-pino": "4.6.1",
    "pino": "9.9.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@dakly/db": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.0.0",
    "read-excel-file": "9.3.10",
    "vitest": "^4.1.12"
  }

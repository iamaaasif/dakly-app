{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": ["vitest"]
    },
    "apps/api": {
      "entry": ["src/main.ts"]
    },
    "apps/worker": {
      "entry": ["src/main.ts"]
    },
    "apps/web": {},
    "apps/admin": {},
    "packages/*": {
      "entry": ["src/**/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/ui": {
      "entry": ["src/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}

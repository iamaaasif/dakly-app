{
  "name": "dakly",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "lint": "eslint . && pnpm lint:boundaries",
    "lint:boundaries": "depcruise apps/*/src packages/*/src --config .dependency-cruiser.cjs",
    "lint:unused": "knip",
    "lint:duplicates": "jscpd",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm lint:unused && pnpm lint:duplicates"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "jscpd": "^5.4.3",
    "knip": "^6.45.1",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
